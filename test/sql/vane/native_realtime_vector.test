# name: test/sql/vane/native_realtime_vector.test
# description: native exact vector retrieval over inlined and materialized DuckLake rows
# group: [vane]

require ducklake

require parquet

statement ok
ATTACH 'ducklake:__TEST_DIR__/vectors.ducklake' AS lake (DATA_PATH '__TEST_DIR__/vectors', DATA_INLINING_ROW_LIMIT 100)

# DuckLake stores lists; the query uses exact Euclidean distance over FLOAT[].
statement ok
CREATE TABLE lake.items(id BIGINT NOT NULL, embedding FLOAT[] NOT NULL, category VARCHAR NOT NULL, payload VARCHAR)

statement ok
INSERT INTO lake.items VALUES (1, [0, 0, 0], 'A', 'old-nearest'), (2, [1, 0, 0], 'A', 'deleted'), (3, [2, 0, 0], 'A', 'stable')

query I
SELECT count(*) FROM glob('__TEST_DIR__/vectors/**/*.parquet')
----
0

query I
SELECT count(*) FROM lake.items WHERE filename LIKE 'ducklake_inlined_data_%'
----
3

query I
SELECT max(snapshot_id) FROM lake.snapshots()
----
2

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1	old-nearest	0
2	deleted	1

# Establish the reader's snapshot before the writer commits.
statement ok reader
BEGIN

query I reader
SELECT id FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1
2

statement ok
BEGIN

statement ok
UPDATE lake.items SET embedding = [9, 0, 0], category = 'B', payload = 'moved' WHERE id = 1

statement ok
DELETE FROM lake.items WHERE id = 2

statement ok
INSERT INTO lake.items VALUES (4, [0, 1, 0], 'A', 'inserted')

statement ok
COMMIT

# The old matching version of ID 1 must not survive the category filter/top-k.
query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
4	inserted	1
3	stable	2

query IIII
SELECT id, embedding[1], category, payload FROM lake.items ORDER BY id
----
1	9	B	moved
3	2	A	stable
4	0	A	inserted

query I reader
SELECT id FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1
2

statement ok
CALL ducklake_flush_inlined_data('lake')

query I
SELECT count(*) > 0 FROM glob('__TEST_DIR__/vectors/**/*.parquet')
----
true

query I
SELECT count(*) FROM lake.items WHERE filename LIKE 'ducklake_inlined_data_%'
----
0

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
4	inserted	1
3	stable	2

# Both an active reader and explicit time travel survive materialization.
query I reader
SELECT id FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1
2

statement ok reader
COMMIT

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items AT (VERSION => 2) WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1	old-nearest	0
2	deleted	1

statement ok
BEGIN

statement ok
UPDATE lake.items SET embedding = [0, 0, 0], payload = 'rolled-back' WHERE id = 3

statement ok
DELETE FROM lake.items WHERE id = 4

statement ok
INSERT INTO lake.items VALUES (5, [0, 0, 0], 'A', 'rolled-back')

statement ok
ROLLBACK

query IIII
SELECT id, embedding[1], category, payload FROM lake.items ORDER BY id
----
1	9	B	moved
3	2	A	stable
4	0	A	inserted

# Mix committed Parquet rows with a new inlined vector.
statement ok
INSERT INTO lake.items VALUES (5, [0, 0, 0], 'A', 'hot')

query II
SELECT count(*) FILTER (WHERE filename LIKE 'ducklake_inlined_data_%'), count(*) FILTER (WHERE filename NOT LIKE 'ducklake_inlined_data_%') FROM lake.items
----
1	3

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
5	hot	0
4	inserted	1

# Delete a materialized vector while the new vector remains inlined.
statement ok
DELETE FROM lake.items WHERE id = 4

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
5	hot	0
3	stable	2

restart

statement ok
ATTACH 'ducklake:__TEST_DIR__/vectors.ducklake' AS lake (DATA_PATH '__TEST_DIR__/vectors', DATA_INLINING_ROW_LIMIT 100)

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
5	hot	0
3	stable	2

query III
SELECT id, payload, list_distance(embedding, [0, 0, 0]::FLOAT[]) FROM lake.items AT (VERSION => 2) WHERE category = 'A' ORDER BY list_distance(embedding, [0, 0, 0]::FLOAT[]), id LIMIT 2
----
1	old-nearest	0
2	deleted	1
