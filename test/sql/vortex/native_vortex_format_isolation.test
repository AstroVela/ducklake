# name: test/sql/vortex/native_vortex_format_isolation.test
# description: uncommitted format changes are invisible to another writer
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/format_isolation.ducklake' AS lake (DATA_PATH '__TEST_DIR__/format_isolation-data',DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT, embedding FLOAT[])

statement ok
CREATE TABLE lake.other(id BIGINT)

statement ok reader
BEGIN

query I reader
SELECT count(*) FROM lake.items
----
0

statement ok writer
BEGIN

statement ok writer
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok reader
INSERT INTO lake.items VALUES (1,[1,2,3])

statement ok writer
ROLLBACK

statement ok reader
COMMIT

query IT
SELECT count(*),min(file_format) FROM __ducklake_metadata_lake.ducklake_data_file
----
1	parquet

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_metadata WHERE key='experimental_data_file_format'
----
0

query IIII
SELECT id,embedding[1],embedding[2],embedding[3] FROM lake.items
----
1	1	2	3


statement ok
DETACH lake
