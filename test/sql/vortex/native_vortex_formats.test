# name: test/sql/vortex/native_vortex_formats.test
# description: mixed native formats, scalar edge cases, empty writes and explicit scope guards
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
SET threads = 1

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_formats.ducklake' AS lake (DATA_PATH '__TEST_DIR__/vortex_formats', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT, embedding FLOAT[], label VARCHAR, score DOUBLE)

statement ok
INSERT INTO lake.items VALUES (1, [1, 2, 3], 'parquet', 1)

statement error
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex')
----
requires table_name

statement error
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'unknown', table_name => 'items')
----
Unsupported DuckLake data file format

statement ok
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'items')

statement ok
INSERT INTO lake.items VALUES (2, [0, -0.25, 1.5], '中文 ''quote''', '-0'::DOUBLE), (3, [1, 1, 1], NULL, 'NaN'::DOUBLE), (4, NULL, 'null-vector', NULL), (5, [], 'empty-vector', 'Infinity'::DOUBLE)

query II
SELECT file_format, sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file GROUP BY file_format ORDER BY file_format
----
parquet	1
vortex	4

query III
SELECT id, label, score IS NULL FROM lake.items ORDER BY id
----
1	parquet	false
2	中文 'quote'	false
3	NULL	false
4	null-vector	true
5	empty-vector	false

query I
SELECT id FROM lake.items WHERE score > 0 ORDER BY id
----
1
3
5

query II
SELECT id, 1::DOUBLE / score < 0 FROM lake.items WHERE score = 0
----
2	true

query III
SELECT id, embedding IS NULL, len(embedding) FROM lake.items WHERE id >= 4 ORDER BY id
----
4	true	NULL
5	false	0

statement ok
INSERT INTO lake.items SELECT 6, [1, 2, 3], 'empty', 1 WHERE false

query I
SELECT sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file
----
5

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_data_file
----
2

query I
SELECT count(*) FROM glob('__TEST_DIR__/vortex_formats/**/*.vortex')
----
1

statement ok
CREATE TABLE lake.unsupported(id BIGINT, payload STRUCT(a INTEGER))

statement error
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'unsupported')
----
do not support type

statement ok
CREATE TABLE lake.partitioned(id BIGINT)

statement ok
ALTER TABLE lake.partitioned SET PARTITIONED BY (id)

statement error
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'partitioned')
----
unpartitioned, unencrypted

statement ok
UPDATE __ducklake_metadata_lake.ducklake_data_file SET file_format = 'unknown' WHERE file_format = 'vortex'

statement error
SELECT id FROM lake.items
----
Unsupported DuckLake data file format
