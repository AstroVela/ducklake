# name: test/sql/vortex/native_vortex_sparse_rewrite.test
# description: explicit sparse-B rewrite publishes bounded F and preserves unselected B, rows and snapshots
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_sparse_rewrite.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_sparse_rewrite_data', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

statement ok
SELECT * FROM ducklake_initialize_vortex_optimizer('lake')

statement ok
INSERT INTO lake.items SELECT i,CASE WHEN i=133 THEN [0.125,0] ELSE [i::FLOAT,0::FLOAT] END,'A',CASE WHEN i=133 THEN NULL ELSE '原始向量' END FROM range(256)t(i)

statement ok
SELECT * FROM ducklake_build_vortex_index('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/sparse-B1.json',2,0)

statement ok
INSERT INTO lake.items SELECT 1000+i,[1000+i,0],'B','unselected' FROM range(128)t(i)

statement ok
SELECT * FROM ducklake_append_vortex_index_segment('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/sparse-B2.json',2,1)

statement ok
SET VARIABLE sparse_generations=(SELECT regexp_extract_all(reference,'"generation":"([^"]+)"',1) FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1)

statement ok
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2,100000,4194304,100000,67108864)

statement ok
SELECT * FROM ducklake_cancel_vortex_optimizer('lake','main','items','knn')

statement ok
SELECT * FROM ducklake_set_vortex_write_budget('lake','main','items','knn',100,4194304,32,67108864)

statement ok
SELECT * FROM ducklake_collect_vortex_builds('lake',16,67108864)

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
requires 1..64 visible rows

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',NULL,2)
----
cannot be NULL

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],-1)
----
Invalid Vortex F rewrite revision

statement ok
DELETE FROM lake.items WHERE id<128 OR (id>=160 AND id<1000)

statement ok
INSERT INTO lake.items VALUES(9999,[0.0625,0],'A','实时-T')

statement ok
CREATE TABLE sparse_expected AS SELECT rowid,id,embedding,category,payload FROM lake.items

statement ok
SET VARIABLE sparse_snapshot=(SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
SELECT * FROM ducklake_set_vortex_write_budget('lake','main','items','knn',100,4194304,31,67108864)

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
unindexed_row_budget

statement ok
SELECT * FROM ducklake_set_vortex_write_budget('lake','main','items','knn',100,4194304,32,1)

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
unindexed_byte_budget

query IIII
SELECT revision,(SELECT sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_builds_v1),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_rewrites_v1) FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1
----
2	384	0	0

statement ok
SELECT * FROM ducklake_set_vortex_write_budget('lake','main','items','knn',100,4194304,32,67108864)

query I
SELECT revision FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
3

query I
SELECT sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL
----
160

query I
SELECT count(*) FROM ((SELECT rowid,id,embedding,category,payload FROM lake.items EXCEPT ALL SELECT * FROM sparse_expected) UNION ALL (SELECT * FROM sparse_expected EXCEPT ALL SELECT rowid,id,embedding,category,payload FROM lake.items))
----
0

query I
SELECT count(*) FROM ((SELECT rowid,id,embedding,category,payload FROM lake.items AT(VERSION=>getvariable('sparse_snapshot')) EXCEPT ALL SELECT * FROM sparse_expected) UNION ALL (SELECT * FROM sparse_expected EXCEPT ALL SELECT rowid,id,embedding,category,payload FROM lake.items AT(VERSION=>getvariable('sparse_snapshot'))))
----
0

query II
SELECT array_length(regexp_extract_all(reference,'"generation":"[^"]+"')),regexp_extract_all(reference,'"generation":"([^"]+)"',1)[1]=getvariable('sparse_generations')[2] FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1
----
1	true

query III
SELECT keep_file,new_file_id IN (SELECT data_file_id FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL AND record_count=32),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_generations_v1) FROM __ducklake_metadata_lake.ducklake_vortex_rewrites_v1
----
true	true	2

query TI
SELECT state,keep_generation FROM ducklake_vortex_build_status('lake')
----
published	false

query IT
SELECT id,payload FROM ducklake_vortex_search('lake','main','items','knn',[0,0]::FLOAT[],1)
----
9999	实时-T

query II
SELECT id,payload IS NULL FROM ducklake_vortex_search('lake','main','items','knn',[0.125,0]::FLOAT[],1)
----
133	true

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
revision conflict

statement error
SELECT * FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],3)
----
selected generation is not ready

statement ok
SELECT * FROM ducklake_collect_vortex_builds('lake',16,67108864)

statement ok
SELECT * FROM ducklake_collect_vortex_generations('lake',16,67108864)

query I
SELECT id FROM ducklake_vortex_search('lake','main','items','knn',[1000,0]::FLOAT[],1,category=>'B')
----
1000

statement ok
DELETE FROM lake.items WHERE id>=1000 AND id<2000

statement ok
SELECT * FROM ducklake_retire_vortex_index_segment('lake','main','items','knn',getvariable('sparse_generations')[2],3)

query I
SELECT array_length(regexp_extract_all(reference,'"generation":"[^"]+"')) FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1
----
0

query IT
SELECT id,payload FROM ducklake_vortex_search('lake','main','items','knn',[0,0]::FLOAT[],1)
----
9999	实时-T

statement ok
DETACH lake
