statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_sparse_rewrite.ducklake' AS lake (DATA_INLINING_ROW_LIMIT 100)

query IIII
SELECT revision,(SELECT max(snapshot_id) FROM lake.snapshots())=getvariable('sparse_snapshot'),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_builds_v1),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_rewrites_v1) FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1
----
2	true	0	0

query I
SELECT revision FROM ducklake_rewrite_vortex_index_segment_to_f('lake','main','items','knn',getvariable('sparse_generations')[1],2)
----
3

statement ok
SET VARIABLE sparse_rewrite_snapshot=(SELECT max(snapshot_id) FROM lake.snapshots())

query III
SELECT
    (SELECT count(*) FROM ducklake_table_insertions('lake','main','items',getvariable('sparse_rewrite_snapshot'),getvariable('sparse_rewrite_snapshot'))),
    (SELECT count(*) FROM ducklake_table_deletions('lake','main','items',getvariable('sparse_rewrite_snapshot'),getvariable('sparse_rewrite_snapshot'))),
    (SELECT count(*) FROM ducklake_table_changes('lake','main','items',getvariable('sparse_rewrite_snapshot'),getvariable('sparse_rewrite_snapshot')))
----
0	0	0

query I
WITH sparse_changes_after AS (
    SELECT * FROM ducklake_table_changes('lake','main','items',getvariable('sparse_first_insert'),getvariable('sparse_rewrite_snapshot'))
)
SELECT count(*) FROM (
    (SELECT * FROM sparse_changes_before EXCEPT ALL SELECT * FROM sparse_changes_after)
    UNION ALL
    (SELECT * FROM sparse_changes_after EXCEPT ALL SELECT * FROM sparse_changes_before)
)
----
0

query I
SELECT sum(record_count) FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL
----
160

query I
SELECT count(*) FROM ((SELECT rowid,id,embedding,category,payload FROM lake.items EXCEPT ALL SELECT * FROM sparse_expected) UNION ALL (SELECT * FROM sparse_expected EXCEPT ALL SELECT rowid,id,embedding,category,payload FROM lake.items))
----
0

query I
SELECT count(*) FROM ((SELECT rowid,id,embedding,category,payload FROM lake.items AT(VERSION=>getvariable('sparse_snapshot')) EXCEPT ALL SELECT * FROM sparse_expected) UNION ALL (SELECT * FROM sparse_expected EXCEPT ALL SELECT rowid,id,embedding,category,payload FROM lake.items AT(VERSION=>getvariable('sparse_snapshot'))))
----
0

query II
SELECT array_length(regexp_extract_all(reference,'"generation":"[^"]+"')),regexp_extract_all(reference,'"generation":"([^"]+)"',1)[1]=getvariable('sparse_generations')[2] FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1
----
1	true

query III
SELECT keep_file,new_file_id IN (SELECT data_file_id FROM __ducklake_metadata_lake.ducklake_data_file WHERE end_snapshot IS NULL AND record_count=32),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_generations_v1) FROM __ducklake_metadata_lake.ducklake_vortex_rewrites_v1
----
true	true	2

query TI
SELECT state,keep_generation FROM ducklake_vortex_build_status('lake')
