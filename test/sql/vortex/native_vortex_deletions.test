# name: test/sql/vortex/native_vortex_deletions.test
# description: deletion snapshots use each file's physical format and embedded logical row identities
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_deletions.ducklake' AS lake (DATA_PATH '__TEST_DIR__/vortex_deletions', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT, embedding FLOAT[])

statement ok
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'items')

statement ok
INSERT INTO lake.items VALUES (1, [1, 2, 3]), (2, [2, 3, 4]), (3, [3, 4, 5]), (4, [4, 5, 6])

statement ok
SET VARIABLE insert_snapshot = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
DELETE FROM lake.items WHERE id = 1

statement ok
DELETE FROM lake.items WHERE id = 3

query IIIIII
SELECT rowid, snapshot_id - getvariable('insert_snapshot'), id, embedding[1], embedding[2], embedding[3] FROM ducklake_table_deletions('lake', 'main', 'items', getvariable('insert_snapshot') + 1, getvariable('insert_snapshot') + 2) ORDER BY rowid
----
0	1	1	1	2	3
2	2	3	3	4	5

# Rewriting leaves logical row IDs 1 and 3 at physical positions 0 and 1.
statement ok
CALL ducklake_rewrite_data_files('lake', 'items', delete_threshold => 0)

query III
SELECT id, rowid, file_row_number FROM lake.items ORDER BY id
----
2	1	0
4	3	1

statement ok
SET VARIABLE rewrite_snapshot = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
DELETE FROM lake.items WHERE id = 2

statement ok
DELETE FROM lake.items WHERE id = 4

query IIIIII
SELECT rowid, snapshot_id - getvariable('rewrite_snapshot'), id, embedding[1], embedding[2], embedding[3] FROM ducklake_table_deletions('lake', 'main', 'items', getvariable('rewrite_snapshot') + 1, getvariable('rewrite_snapshot') + 2) ORDER BY rowid
----
1	1	2	2	3	4
3	2	4	4	5	6

# The same table can contain old Parquet files and new Vortex files.
statement ok
CREATE TABLE lake.mixed(id BIGINT, embedding FLOAT[])

statement ok
INSERT INTO lake.mixed VALUES (1, [1, 2, 3]), (2, [2, 3, 4])

statement ok
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'mixed')

statement ok
INSERT INTO lake.mixed VALUES (3, [3, 4, 5]), (4, [4, 5, 6])

statement ok
SET VARIABLE mixed_snapshot = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
DELETE FROM lake.mixed WHERE id = 1

statement ok
DELETE FROM lake.mixed WHERE id = 3

query IIIIII
SELECT rowid, snapshot_id - getvariable('mixed_snapshot'), id, embedding[1], embedding[2], embedding[3] FROM ducklake_table_deletions('lake', 'main', 'mixed', getvariable('mixed_snapshot') + 1, getvariable('mixed_snapshot') + 2) ORDER BY rowid
----
0	1	1	1	2	3
2	2	3	3	4	5

# Flushed inline rows also retain their original row IDs and snapshot column.
statement ok
CREATE TABLE lake.flushed(id BIGINT, embedding FLOAT[])

statement ok
CALL ducklake_set_option('lake', 'experimental_data_file_format', 'vortex', table_name => 'flushed')

statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 100, table_name => 'flushed')

statement ok
INSERT INTO lake.flushed VALUES (1, [1, 2, 3]), (2, [2, 3, 4]), (3, [3, 4, 5])

statement ok
DELETE FROM lake.flushed WHERE id = 2

statement ok
CALL ducklake_flush_inlined_data('lake')

statement ok
SET VARIABLE flush_snapshot = (SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
DELETE FROM lake.flushed WHERE id = 1

statement ok
DELETE FROM lake.flushed WHERE id = 3

query IIIIII
SELECT rowid, snapshot_id - getvariable('flush_snapshot'), id, embedding[1], embedding[2], embedding[3] FROM ducklake_table_deletions('lake', 'main', 'flushed', getvariable('flush_snapshot') + 1, getvariable('flush_snapshot') + 2) ORDER BY rowid
----
0	1	1	1	2	3
2	2	3	3	4	5

statement ok
DETACH lake
