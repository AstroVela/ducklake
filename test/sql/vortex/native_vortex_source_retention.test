# name: test/sql/vortex/native_vortex_source_retention.test
# description: explicit bounded snapshot retention preserves current vectors and durable request receipts
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_source_retention.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_source_retention_data', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

statement ok
SELECT * FROM ducklake_initialize_vortex_optimizer('lake')

statement ok
SELECT * FROM ducklake_initialize_vortex_writes('lake')

statement ok
SELECT * FROM ducklake_create_vortex_index('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2)

query III
SELECT enabled::INTEGER,keep_snapshots,min_age_seconds FROM ducklake_vortex_source_retention_status('lake')
----
0	1	0

query IIII
SELECT expired_snapshots,collected_files,collected_bytes,blocked_by_transactions::INTEGER FROM ducklake_collect_vortex_sources('lake',1,1)
----
0	0	0	0

statement error
SELECT * FROM ducklake_set_vortex_source_retention('lake',true,0,0)
----
Invalid Vortex source retention policy

statement error
SELECT * FROM ducklake_set_vortex_source_retention('lake',true,1,-1)
----
Invalid Vortex source retention policy

statement error
SELECT * FROM ducklake_collect_vortex_sources('lake',17,67108864)
----
Invalid Vortex source collection budgets

statement ok
SELECT * FROM ducklake_write_vortex_batch('lake','main','items','knn','seed',[{'id':1,'embedding':[1,0],'category':'A','payload':'原始'},{'id':2,'embedding':[2,0],'category':NULL,'payload':NULL}])

statement ok
SELECT * FROM ducklake_write_vortex_batch('lake','main','items','knn','next',[{'id':100,'embedding':[100,0],'category':'A','payload':'后续'}])

statement ok
DELETE FROM lake.items WHERE id=1

statement ok
SELECT * FROM ducklake_set_vortex_source_retention('lake',true,1,315360000)

query I
SELECT eligible_snapshots FROM ducklake_vortex_source_retention_status('lake')
----
0

query I
SELECT expired_snapshots FROM ducklake_collect_vortex_sources('lake',16,67108864)
----
0

statement ok
SELECT * FROM ducklake_set_vortex_source_retention('lake',true,1,0)

query I
SELECT expired_snapshots FROM ducklake_collect_vortex_sources('lake',1,1)
----
1

statement ok
SELECT * FROM ducklake_collect_vortex_sources('lake',16,67108864)

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_snapshot
----
1

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_write_requests_v1 r JOIN __ducklake_metadata_lake.ducklake_snapshot s USING(snapshot_id) WHERE request_id='seed'
----
0

query TI
SELECT request_id,row_count FROM ducklake_write_vortex_batch('lake','main','items','knn','seed',[{'id':1,'embedding':[1,0],'category':'A','payload':'原始'},{'id':2,'embedding':[2,0],'category':NULL,'payload':NULL}])
----
seed	2

query IT
SELECT id,payload FROM lake.items ORDER BY id
----
2	NULL
100	后续

query I
SELECT id FROM ducklake_vortex_search('lake','main','items','knn',[0,0]::FLOAT[],1)
----
2

statement ok
BEGIN

statement error
SELECT * FROM ducklake_collect_vortex_sources('lake',1,1)
----
autocommit

statement ok
ROLLBACK

statement ok
BEGIN

statement error
SELECT * FROM ducklake_set_vortex_source_retention('lake',false,1,0)
----
autocommit

statement ok
ROLLBACK

statement ok
SELECT * FROM ducklake_set_vortex_source_retention('lake',false,1,0)

query II
SELECT enabled::INTEGER,pending_deletions FROM ducklake_vortex_source_retention_status('lake')
----
0	0

statement ok
DETACH lake
