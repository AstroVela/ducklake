# name: test/sql/vortex/native_vortex_format_retry.test
# description: format settings and file identities survive a metadata snapshot retry
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/format_retry.ducklake' AS lake (DATA_PATH '__TEST_DIR__/format_retry-data',DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT, embedding FLOAT[])

statement ok
CREATE TABLE lake.other(id BIGINT)

statement ok writer
BEGIN

statement ok writer
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok writer
INSERT INTO lake.items VALUES (1,[1,2,3]),(2,[2,3,4])

statement ok other
INSERT INTO lake.other VALUES (99)

statement ok writer
COMMIT

query IT
SELECT count(*),min(value) FROM __ducklake_metadata_lake.ducklake_metadata WHERE key='experimental_data_file_format' AND scope='table'
----
1	vortex

query IT
SELECT count(*),min(file_format) FROM __ducklake_metadata_lake.ducklake_data_file WHERE table_id=(SELECT table_id FROM __ducklake_metadata_lake.ducklake_table WHERE table_name='items')
----
1	vortex

statement ok
CALL ducklake_set_option('lake','data_inlining_row_limit',100,table_name=>'items')

statement ok
INSERT INTO lake.items VALUES (1000,[3,4,5])

query IIII
SELECT id,embedding[1],embedding[2],embedding[3] FROM lake.items ORDER BY id
----
1	1	2	3
2	2	3	4
1000	3	4	5


statement ok
DETACH lake
