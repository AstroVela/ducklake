# name: test/sql/vortex/native_vortex_format_first_set_race.test
# description: a default format request does not compete with the first Vortex transition
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/format_first_set_race.ducklake' AS lake (DATA_PATH '__TEST_DIR__/format_first_set_race-data',DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT, embedding FLOAT[])

statement ok
CREATE TABLE lake.other(id BIGINT)

statement ok writer
BEGIN

statement ok reader
BEGIN

statement ok writer
CALL ducklake_set_option('lake','experimental_data_file_format','parquet',table_name=>'items')

statement ok reader
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok reader
INSERT INTO lake.items VALUES (1, [1, 2, 3]), (2, [2, 3, 4])

statement ok writer
COMMIT

statement ok reader
COMMIT

query IT
SELECT count(*),min(value) FROM __ducklake_metadata_lake.ducklake_metadata WHERE key='experimental_data_file_format' AND scope='table'
----
1	vortex


statement ok
DETACH lake

statement ok
ATTACH 'ducklake:__TEST_DIR__/format_first_set_race.ducklake' AS lake (DATA_PATH '__TEST_DIR__/format_first_set_race-data', DATA_INLINING_ROW_LIMIT 0)

statement ok
CALL ducklake_set_option('lake', 'data_inlining_row_limit', 100, table_name => 'items')

statement ok
INSERT INTO lake.items VALUES (1000, [3, 4, 5])

query IIII
SELECT id, embedding[1], embedding[2], embedding[3] FROM lake.items ORDER BY id
----
1	1	2	3
2	2	3	4
1000	3	4	5

statement ok
DETACH lake
