# name: test/sql/vortex/native_vortex_rewrite_planning.test
# description: managed replacement masks an entire 512-row B while F/T remain queryable and can become a new B
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_rewrite_planning.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_rewrite_planning_data', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

statement ok
SELECT * FROM ducklake_initialize_vortex_optimizer('lake')

statement ok
SELECT * FROM ducklake_initialize_vortex_writes('lake')

statement ok
SELECT * FROM ducklake_create_vortex_index('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2)

statement ok
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2,100000,4194304,100000,67108864)

statement ok
SELECT * FROM ducklake_cancel_vortex_optimizer('lake','main','items','knn')

statement ok
SELECT * FROM ducklake_manage_vortex_writes('lake','main','items','knn')

statement ok
SELECT * FROM ducklake_set_vortex_write_budget('lake','main','items','knn',256,4194304,1024,67108864)

statement ok
SET VARIABLE seed_batch=(SELECT list({'id':i::BIGINT,'embedding':[i,0]::FLOAT[],'category':'A'::VARCHAR,'payload':'original'::VARCHAR}) FROM range(512)t(i))

statement ok
SELECT * FROM ducklake_mutate_vortex_batch('lake','main','items','knn','seed',getvariable('seed_batch'),[]::BIGINT[],1)

query I
SELECT revision FROM ducklake_append_vortex_index_segment('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/planning-first.json',2,1)
----
2

statement ok
SET VARIABLE original_generation=(SELECT regexp_extract(reference,'"generation":"([^"]+)"',1) FROM __ducklake_metadata_lake.ducklake_vortex_indexes_v1)

statement ok
SET VARIABLE original_snapshot=(SELECT max(snapshot_id) FROM lake.snapshots())

statement ok
CALL ducklake_set_option('lake','data_inlining_row_limit',1000,table_name=>'items')

statement ok
SET VARIABLE first_batch=(SELECT list({'id':i::BIGINT,'embedding':[i+0.125,0]::FLOAT[],'category':'B'::VARCHAR,'payload':NULL::VARCHAR}) FROM range(256)t(i))

statement ok
SELECT * FROM ducklake_mutate_vortex_batch('lake','main','items','knn','first-half',getvariable('first_batch'),[]::BIGINT[],1)

statement ok
CALL ducklake_flush_inlined_data('lake',table_name=>'items')

statement ok
SET VARIABLE second_batch=(SELECT list({'id':i::BIGINT,'embedding':[i+0.125,0]::FLOAT[],'category':'B'::VARCHAR,'payload':NULL::VARCHAR}) FROM range(256,512)t(i))

statement ok
SELECT * FROM ducklake_mutate_vortex_batch('lake','main','items','knn','second-half',getvariable('second_batch'),[]::BIGINT[],1)

query III
SELECT count(*),count(DISTINCT id),count(*) FILTER(WHERE category='B' AND payload IS NULL) FROM lake.items
----
512	512	512

query I
SELECT revision FROM ducklake_retire_vortex_index_segment('lake','main','items','knn',getvariable('original_generation'),2)
----
3

query IT
SELECT id,payload FROM ducklake_vortex_search('lake','main','items','knn',[0.125,0]::FLOAT[],1,category=>'B')
----
0	NULL

query I
SELECT count(*) FROM lake.items AT(VERSION=>getvariable('original_snapshot')) WHERE category='A' AND payload='original'
----
512

statement ok
CALL ducklake_flush_inlined_data('lake',table_name=>'items')

query I
SELECT revision FROM ducklake_append_vortex_index_segment('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/planning-next.json',2,3)
----
4

statement ok
SELECT * FROM ducklake_mutate_vortex_batch('lake','main','items','knn','first-half',getvariable('first_batch'),[]::BIGINT[],1)

query III
SELECT count(*),count(DISTINCT id),(SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_write_requests_v2) FROM lake.items
----
512	512	3

query IT
SELECT id,payload FROM ducklake_vortex_search('lake','main','items','knn',[511.125,0]::FLOAT[],1,category=>'B')
----
511	NULL

statement ok
DETACH lake
