# name: test/sql/vortex/native_vortex_optimizer.test
# description: explicit bounded optimizer policies, status and cancellation
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_optimizer.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_optimizer_data', DATA_INLINING_ROW_LIMIT 100)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement error
SELECT * FROM ducklake_initialize_vortex_optimizer('lake')
----
index catalog is not initialized

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

statement error
SELECT * FROM ducklake_vortex_optimizer_status('lake')
----
optimizer catalog is not initialized

query T
SELECT state FROM ducklake_initialize_vortex_optimizer('lake')
----
initialized

statement error
SELECT * FROM ducklake_initialize_vortex_optimizer('lake')
----
already exists

statement error
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','unused',0,128,4194304,128,67108864)
----
must be positive

statement error
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn',NULL,2,128,4194304,128,67108864)
----
cannot be NULL

statement error
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','unused',2,128,4194304,128,67108864)
----
requires Vortex output and auto_compact=true

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

query T
SELECT state FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2,128,4194304,128,67108864)
----
enabled

statement error
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/vortex_optimizer_data',2,128,4194304,128,67108864)
----
root must be outside managed data

query TII
SELECT state,enabled,run_count FROM ducklake_vortex_optimizer_status('lake')
----
idle	true	0

statement error
SELECT * FROM ducklake_enable_vortex_optimizer('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2,128,4194304,128,67108864)
----
Duplicate key

query T
SELECT state FROM ducklake_cancel_vortex_optimizer('lake','main','items','knn')
----
cancellation_requested

query TII
SELECT state,enabled,run_count FROM ducklake_vortex_optimizer_status('lake')
----
cancelled	false	0

query T
SELECT state FROM ducklake_resume_vortex_optimizer('lake','main','items','knn')
----
idle

statement ok
SELECT * FROM ducklake_cancel_vortex_optimizer('lake','main','items','knn')

statement ok
DETACH lake
