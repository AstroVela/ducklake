# name: test/sql/vortex/native_vortex_generation_gc.test
# description: atomically retire generations and bound collection across named-index references
# group: [vortex]

require ducklake

require parquet

require vortex

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_gc.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_gc_data', DATA_INLINING_ROW_LIMIT 0)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement error
SELECT * FROM ducklake_collect_vortex_generations('lake',1,67108864)
----
index catalog is not initialized

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

query III
SELECT * FROM ducklake_collect_vortex_generations('lake',1,67108864)
----
0	0	0

statement error
SELECT * FROM ducklake_collect_vortex_generations('lake',0,67108864)
----
collection count or artifact byte budget

statement error
SELECT * FROM ducklake_collect_vortex_generations('lake',17,67108864)
----
collection count or artifact byte budget

statement error
SELECT * FROM ducklake_collect_vortex_generations('lake',1,67108865)
----
collection count or artifact byte budget

statement ok
INSERT INTO lake.items SELECT i,[i::FLOAT,0::FLOAT],'A','B1' FROM range(128)t(i)

query I
SELECT revision FROM ducklake_build_vortex_index('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B1.json',2,0)
----
1

statement ok
INSERT INTO lake.items SELECT 1000+i,[0.125+i,0],'B','B2' FROM range(128)t(i)

query I
SELECT revision FROM ducklake_append_vortex_index_segment('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B2.json',2,1)
----
2

statement ok
INSERT INTO lake.items SELECT 2000+i,[0.0625+i,0],'C','B3' FROM range(128)t(i)

query I
SELECT revision FROM ducklake_append_vortex_index_segment('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B3.json',2,2)
----
3

query I
SELECT revision FROM ducklake_publish_vortex_index('lake','main','items','alias','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B2.json',0)
----
1

query II
SELECT count(*),sum(reference_count) FROM ducklake_vortex_generation_status('lake') WHERE state='active'
----
3	4

statement ok
SET VARIABLE gc_generations = (SELECT regexp_extract_all(admission,'"generation":"([^"]+)"',1) FROM ducklake_vortex_index_view('lake','main','items','knn',67108864,100000))

query I
SELECT revision FROM ducklake_merge_vortex_index_segments('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B23.json',getvariable('gc_generations')[2:3],3)
----
4

query II
SELECT count(*) FILTER(WHERE state='active'),count(*) FILTER(WHERE state='retired') FROM ducklake_vortex_generation_status('lake')
----
3	1

query III
SELECT * FROM ducklake_collect_vortex_generations('lake',1,1)
----
0	0	1

query II
SELECT collected_generations,remaining_generations FROM ducklake_collect_vortex_generations('lake',1,67108864)
----
1	0

query I
SELECT id FROM ducklake_vortex_search('lake','main','items','alias',[0,0]::FLOAT[],1,category=>'B')
----
1000

query I
SELECT revision FROM ducklake_publish_vortex_index('lake','main','items','alias','__WORKING_DIRECTORY__/__TEST_DIR__/gc-B23.json',1)
----
2

query II
SELECT count(*) FILTER(WHERE state='active'),count(*) FILTER(WHERE state='retired') FROM ducklake_vortex_generation_status('lake')
----
2	1

query II
SELECT collected_generations,remaining_generations FROM ducklake_collect_vortex_generations('lake',16,67108864)
----
1	0

query III
SELECT * FROM ducklake_collect_vortex_generations('lake',16,67108864)
----
0	0	0

query III
SELECT count(*),min(reference_count),max(reference_count) FROM ducklake_vortex_generation_status('lake') WHERE state='active'
----
2	1	2

query I
SELECT id FROM ducklake_vortex_search('lake','main','items','knn',[0,0]::FLOAT[],1,category=>'C')
----
2000

statement ok
DETACH lake
