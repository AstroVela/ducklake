# name: test/sql/vortex/native_vortex_write_batch.test
# description: table-scoped native request identity commits atomically with a typed Vortex batch
# group: [vortex]

require ducklake

require parquet

require vortex

statement error
SELECT * FROM ducklake_initialize_vortex_writes('memory')
----
attached DuckLake catalog

statement ok
ATTACH 'ducklake:__TEST_DIR__/vortex_write_batch.ducklake' AS lake (DATA_PATH '__WORKING_DIRECTORY__/__TEST_DIR__/vortex_write_batch_data', DATA_INLINING_ROW_LIMIT 1000)

statement ok
CREATE TABLE lake.items(id BIGINT,embedding FLOAT[],category VARCHAR,payload VARCHAR)

statement ok
CALL ducklake_set_option('lake','experimental_data_file_format','vortex',table_name=>'items')

statement ok
SELECT * FROM ducklake_initialize_vortex_indexes('lake')

statement ok
SELECT * FROM ducklake_create_vortex_index('lake','main','items','knn','__WORKING_DIRECTORY__/__TEST_DIR__',2)

statement error
SELECT * FROM ducklake_write_vortex_batch('lake','main','items','knn','r1',[{'id':1,'embedding':[1,0],'category':'A','payload':'一'}])
----
WriteBatch catalog is not initialized

statement ok
SELECT * FROM ducklake_initialize_vortex_writes('lake')

query TI
SELECT request_id,row_count FROM ducklake_write_vortex_batch('lake','main','items','knn','r1',[{'id':1,'embedding':[1,0],'category':'A','payload':'一'},{'id':2,'embedding':[2,0],'category':NULL,'payload':NULL}])
----
r1	2

query I
SELECT count(*) FROM __ducklake_metadata_lake.ducklake_vortex_write_requests_v1 r JOIN __ducklake_metadata_lake.ducklake_snapshot s USING(snapshot_id) WHERE r.request_id='r1' AND r.row_count=2 AND starts_with(r.payload_hash,'sha256:')
----
1

query TI
SELECT request_id,row_count FROM ducklake_write_vortex_batch('lake','main','items','knn','r1',[{'id':1,'embedding':[1,0],'category':'A','payload':'一'},{'id':2,'embedding':[2,0],'category':NULL,'payload':NULL}])
----
r1	2

query I
SELECT count(*) FROM lake.items
----
2

query IT rowsort
SELECT id,payload FROM ducklake_vortex_search('lake','main','items','knn',[0,0]::FLOAT[],10)
----
1	一
2	NULL

