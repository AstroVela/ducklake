+        std::vector<std::pair<SizeType, std::string>> ProbeRecords() {
+            std::vector<std::pair<SizeType, std::string>> result;
+            std::unique_ptr<rocksdb::Iterator> it(db->NewIterator(rocksdb::ReadOptions()));
+            size_t total = 0;
+            for (it->SeekToFirst(); it->Valid(); it->Next()) {
+                if (it->key().size() != sizeof(SizeType)) throw std::runtime_error("Invalid posting key");
+                SizeType key;
+                memcpy(&key, it->key().data(), sizeof(key));
+                total += it->value().size();
+                if (total > 64ULL * 1024 * 1024) throw std::runtime_error("Posting byte budget");
+                result.emplace_back(key, it->value().ToString());
+            }
+            if (!it->status().ok()) throw std::runtime_error("Posting iteration failed");
+            return result;
+        }
